{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "fsharp",
  "word": "identifier",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_token"
      }
    },
    "import_decl": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "open"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "type"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "long_identifier"
        }
      ]
    },
    "_token": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "import_decl"
        },
        {
          "type": "SYMBOL",
          "name": "bool_literal"
        },
        {
          "type": "SYMBOL",
          "name": "unit"
        },
        {
          "type": "SYMBOL",
          "name": "null_literal"
        },
        {
          "type": "SYMBOL",
          "name": "long_identifier"
        },
        {
          "type": "SYMBOL",
          "name": "line_comment"
        },
        {
          "type": "SYMBOL",
          "name": "int_literal"
        },
        {
          "type": "SYMBOL",
          "name": "float_literal"
        }
      ]
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[a-zA-Z_][a-zA-Z0-9_']*"
    },
    "long_identifier": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "identifier"
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "."
                },
                {
                  "type": "SYMBOL",
                  "name": "identifier"
                }
              ]
            }
          }
        ]
      }
    },
    "_int": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[0-9][0-9_]*"
      }
    },
    "_hex": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "0x"
              },
              {
                "type": "STRING",
                "value": "0X"
              }
            ]
          },
          {
            "type": "PATTERN",
            "value": "[0-9a-fA-F_]+"
          }
        ]
      }
    },
    "_oct": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "0o"
              },
              {
                "type": "STRING",
                "value": "0O"
              }
            ]
          },
          {
            "type": "PATTERN",
            "value": "[0-7_]+"
          }
        ]
      }
    },
    "_bin": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "0b"
              },
              {
                "type": "STRING",
                "value": "0B"
              }
            ]
          },
          {
            "type": "PATTERN",
            "value": "[01_]+"
          }
        ]
      }
    },
    "_int_suffix": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "STRING",
            "value": "uy"
          },
          {
            "type": "STRING",
            "value": "us"
          },
          {
            "type": "STRING",
            "value": "uL"
          },
          {
            "type": "STRING",
            "value": "UL"
          },
          {
            "type": "STRING",
            "value": "Ul"
          },
          {
            "type": "STRING",
            "value": "ul"
          },
          {
            "type": "STRING",
            "value": "un"
          },
          {
            "type": "STRING",
            "value": "u"
          },
          {
            "type": "STRING",
            "value": "y"
          },
          {
            "type": "STRING",
            "value": "s"
          },
          {
            "type": "STRING",
            "value": "l"
          },
          {
            "type": "STRING",
            "value": "L"
          },
          {
            "type": "STRING",
            "value": "n"
          },
          {
            "type": "STRING",
            "value": "I"
          },
          {
            "type": "STRING",
            "value": "m"
          },
          {
            "type": "STRING",
            "value": "M"
          },
          {
            "type": "STRING",
            "value": "f"
          },
          {
            "type": "STRING",
            "value": "F"
          }
        ]
      }
    },
    "_float_suffix": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "STRING",
            "value": "f"
          },
          {
            "type": "STRING",
            "value": "F"
          },
          {
            "type": "STRING",
            "value": "m"
          },
          {
            "type": "STRING",
            "value": "M"
          }
        ]
      }
    },
    "int_literal": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_hex"
            },
            {
              "type": "SYMBOL",
              "name": "_oct"
            },
            {
              "type": "SYMBOL",
              "name": "_bin"
            },
            {
              "type": "SYMBOL",
              "name": "_int"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_int_suffix"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "float_literal": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "TOKEN",
              "content": {
                "type": "SEQ",
                "members": [
                  {
                    "type": "PATTERN",
                    "value": "[0-9][0-9_]*"
                  },
                  {
                    "type": "STRING",
                    "value": "."
                  },
                  {
                    "type": "PATTERN",
                    "value": "[0-9_]*"
                  },
                  {
                    "type": "CHOICE",
                    "members": [
                      {
                        "type": "SEQ",
                        "members": [
                          {
                            "type": "PATTERN",
                            "value": "[eE]"
                          },
                          {
                            "type": "CHOICE",
                            "members": [
                              {
                                "type": "PATTERN",
                                "value": "[+-]"
                              },
                              {
                                "type": "BLANK"
                              }
                            ]
                          },
                          {
                            "type": "PATTERN",
                            "value": "[0-9]+"
                          }
                        ]
                      },
                      {
                        "type": "BLANK"
                      }
                    ]
                  }
                ]
              }
            },
            {
              "type": "TOKEN",
              "content": {
                "type": "SEQ",
                "members": [
                  {
                    "type": "PATTERN",
                    "value": "[0-9]+"
                  },
                  {
                    "type": "PATTERN",
                    "value": "[eE]"
                  },
                  {
                    "type": "CHOICE",
                    "members": [
                      {
                        "type": "PATTERN",
                        "value": "[+-]"
                      },
                      {
                        "type": "BLANK"
                      }
                    ]
                  },
                  {
                    "type": "PATTERN",
                    "value": "[0-9]+"
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_float_suffix"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "bool_literal": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "true"
        },
        {
          "type": "STRING",
          "value": "false"
        }
      ]
    },
    "unit": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "("
          },
          {
            "type": "STRING",
            "value": ")"
          }
        ]
      }
    },
    "null_literal": {
      "type": "TOKEN",
      "content": {
        "type": "STRING",
        "value": "null"
      }
    },
    "line_comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "//"
          },
          {
            "type": "PATTERN",
            "value": ".*"
          }
        ]
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s+"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}