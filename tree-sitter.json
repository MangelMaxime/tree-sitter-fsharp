{
    "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
    "grammars": [
        {
            "name": "fsharp",
            "camelcase": "FSharp",
            "title": "F#",
            "scope": "source.fsharp",
            "file-types": [
                "fs",
                "fsx"
            ],
            "highlights": "queries/highlights.scm",
            "locals": "queries/locals.scm",
            "injection-regex": "^fsharp$",
            "class-name": "TreeSitterFsharp",
            "external-files": [
                "src/scanner.c"
            ]
        }
    ],
    "metadata": {
        "version": "0.0.0",
        "license": "MIT",
        "description": "F# tree sitter definition",
        "authors": [
            {
                "name": "Mangel Maxime",
                "url": "https://github.com/MangelMaxime/"
            }
        ],
        "links": {
            "repository": "https://github.com/MangelMaxime/tree-sitter-fsharp/",
            "funding": "https://mangelmaxime.github.io/sponsors/"
        }
    },
    "bindings": {
        "c": false,
        "go": false,
        "java": false,
        "node": false,
        "python": false,
        "rust": false,
        "swift": false,
        "zig": false
    }
}
