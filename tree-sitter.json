{
    "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
    "grammars": [
        {
            "name": "fsharp",
            "camelcase": "FSharp",
            "title": "F#",
            "scope": "source.fsharp",
            "file-types": [
                "fs",
                "fsx"
            ],
            "highlights": "queries/highlights.scm",
            "locals": "queries/locals.scm",
            "injection-regex": "^fsharp$",
            "class-name": "TreeSitterFsharp",
            "external-files": [
                "src/scanner.c"
            ]
        },
        {
            "name": "fsharp_signature",
            "camelcase": "FSharpSignature",
            "title": "F# signature",
            "scope": "source.fsharp.signature",
            "path": "signature",
            "file-types": [
                "fsi"
            ],
            "highlights": "queries/signature/highlights.scm",
            "locals": "queries/signature/locals.scm",
            "injection-regex": "^fsharp_signature$",
            "class-name": "TreeSitterFsharpSignature",
            "external-files": [
                "src/scanner.c"
            ]
        }
    ],
    "metadata": {
        "version": "0.2.0",
        "links": {
            "repository": "https://github.com/MangelMaxime/tree-sitter-fsharp/"
        },
        "authors": [
            {
                "name": "Maxime Mangel"
            }
        ],
        "license": "Apache 2.0"
    },
    "bindings": {
        "c": false,
        "go": false,
        "java": false,
        "node": false,
        "python": false,
        "rust": false,
        "swift": false,
        "zig": false
    }
}
