{
    "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
    "grammars": [
        {
            "name": "fsharp",
            "camelcase": "FSharp",
            "title": "F#",
            "scope": "source.fsharp",
            "file-types": [
                "fs",
                "fsx",
                "fsi"
            ],
            "highlights": "queries/highlights.scm",
            "locals": "queries/locals.scm",
            "injection-regex": "^fsharp$",
            "class-name": "TreeSitterFsharp",
            "external-files": [
                "src/scanner.c"
            ]
        }
    ],
    "metadata": {
        "version": "0.1.0"
    },
    "bindings": {
        "c": false,
        "go": false,
        "java": false,
        "node": false,
        "python": false,
        "rust": false,
        "swift": false,
        "zig": false
    }
}